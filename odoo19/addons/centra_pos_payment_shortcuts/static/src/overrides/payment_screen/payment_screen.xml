<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="centra_pos_payment_shortcuts.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension" >

        <xpath expr="//button[hasclass('button') and hasclass('js_cashdrawer')]" position="replace"></xpath>
        <div>
        </div>
        </t>


<t t-name="centra_pos_payment_shortcuts.PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension" >

    <xpath expr="//div[hasclass('flex-grow-1') and hasclass('flex-column') and hasclass('gap-1')]" position="after">
        
        <div class="paymentmethods-container mb-3" t-att-class="ui.isSmall ? 'my-2 rounded-3' : 'flex-grow-1'">
            <div class="paymentmethods  gap-1 gap-lg-2" t-att-class="{ 'd-grid p-1 gap-1 overflow-y-auto rounded-3 bg-300': ui.isSmall, 'd-flex flex-column gap-lg-2': !ui.isSmall }">
                <t t-set="buttons" t-value="this.getCashValidationButtons()" />
                <t t-set="btn_count" t-value="buttons.length" />
        
                <t t-foreach="buttons" t-as="item" t-key="item_index">
                    <div class="button paymentmethod btn btn-secondary btn-lg lh-lg flex-fill"
                        t-on-click="() => { this.updateSelectedPaymentline(item); this.validateOrder(); }"
                        >

                     <t t-esc="item" />
                        
                    </div>
                </t>
            </div>
        </div>
        
</xpath>


    


        <xpath expr="//Numpad[1]" position="after">
    <div style="margin-top: 10px; margin-bottom: 20px;">
<div class="d-flex flex-column flex-sm-row gap-2 w-100">
    <t t-if="!currentOrder?.isEmpty() &amp;&amp; !ui.isSmall &amp;&amp; currentOrder?.totalDue &gt; 0" t-foreach="this.getCashValidationButtons()" t-as="item"  t-key="item_index">
       
        <button class="pay pay-order-button button btn btn-secondary btn-lg py-3 d-flex align-items-center
        justify-content-center flex-fill"
    t-on-click="() => {this.updateSelectedPaymentline(this.proccessPayment(item)), this.validateOrder()}"><t
        t-esc="item"/>
</button>

    </t>
               
           </div>
        </div>
</xpath>

</t>

<t t-name='centra_pos_payment_shortcuts.PaymentScreenValidate' t-inherit="point_of_sale.PaymentScreenValidate" t-inherit-mode="extension">

    <xpath expr="//button[hasclass('validation-button')]" position="before">
 <button t-on-click="() => this.toggleChange()"  t-attf-class="
    
 {{this?.change?.isChange ? 'btn-dark' : 'btn-secondary'}}
  {{ ui.isSmall ? 'btn-switchpane flex-fill' : 'button next w-50' }}
 
 " class="validation-button next btn btn-primary btn-lg py-3 lh-lg">Change</button>
    </xpath>
</t>
</templates>