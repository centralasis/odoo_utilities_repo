<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">


<t t-name="centra_pos_payment_shortcuts.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension" >
 

<xpath expr="//ActionpadWidget[1]" position="replace">
<div  t-if="!currentOrder?.isEmpty() &amp;&amp; !ui.isSmall &amp;&amp; currentOrder?.totalDue &gt; 0"
  class="d-flex flex-column flex-sm-row gap-2 w-100" style="margin-top: 10px; margin-bottom: 10px;">
    <t t-foreach="this.getCashValidationButtons()" t-as="item"  t-key="item_index">
       
        <button class="pay pay-order-button button btn btn-secondary btn-lg py-3 d-flex align-items-center justify-content-center flex-fill"
    t-on-click="() => pos.pay(this.proccessPayment(item))"><t t-esc="item"/>
</button>

    </t>
    
            </div>

            <ActionpadWidget 
            partner="currentOrder?.getPartner()" 
            onClickMore.bind="displayAllControlPopup"
            actionName.translate="Payment"
            actionToTrigger="() => pos.pay()"
            change = "this.change"
            showActionButton="!currentOrder?.isEmpty()"
            cashValidateAmount="this.cashValidate()"
            fastValidate="(paymentMethod) => this.fastValidate(paymentMethod)"
        />
</xpath>

</t>
</templates>