[Desktop Entry]
Type=Application
Name=Chrome Kiosk Mode
Exec=/usr/bin/google-chrome \
    --kiosk http://localhost:8069 \
    --user-data-dir=/opt/chrome-kiosk-profile \
    --no-first-run \
    --no-default-browser-check \
    --disable-session-crashed-bubble \
    --disable-save-password-bubble \
    --disable-notifications \
    --disable-infobars \
    --disable-popup-blocking \
    --disable-sync \
    --disable-translate \
    --disable-features=PasswordManagerEnabled,AutofillServerCommunication,NotificationTriggers,Translate,MediaRouter,GlobalMediaControls,ChromeWhatsNewUI \
    --overscroll-history-navigation=0 \
    --check-for-update-interval=31536000 \
    --password-store=basic
Terminal=false
StartupNotify=false
X-GNOME-Autostart-enabled=true
